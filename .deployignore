# Pressable maps repository wp-content/ to /htdocs/wp-content/.
#
# Preserve every server-side wp-content entry by default. Only this
# repository's owned theme and plugins are synchronized from Git.
wp-content/*
!wp-content/themes/
!wp-content/themes/**
!wp-content/plugins/
!wp-content/plugins/**

wp-content/themes/*
!wp-content/themes/nolan-young-theme-template-01/
!wp-content/themes/nolan-young-theme-template-01/**

wp-content/plugins/*
!wp-content/plugins/nyforms/
!wp-content/plugins/nyforms/**
!wp-content/plugins/nymegamenu/
!wp-content/plugins/nymegamenu/**

# Pressable-managed and site-specific must-use plugins stay server-owned.
wp-content/mu-plugins/

# Theme development sources, dependencies, tests, and release tooling.
wp-content/themes/nolan-young-theme-template-01/accessibility/
wp-content/themes/nolan-young-theme-template-01/build/
wp-content/themes/nolan-young-theme-template-01/dist/
wp-content/themes/nolan-young-theme-template-01/docs/
wp-content/themes/nolan-young-theme-template-01/node_modules/
wp-content/themes/nolan-young-theme-template-01/src/
wp-content/themes/nolan-young-theme-template-01/tests/
wp-content/themes/nolan-young-theme-template-01/composer.json
wp-content/themes/nolan-young-theme-template-01/composer.lock
wp-content/themes/nolan-young-theme-template-01/CONTRIBUTING.md
wp-content/themes/nolan-young-theme-template-01/FILE-MANIFEST.txt
wp-content/themes/nolan-young-theme-template-01/package.json
wp-content/themes/nolan-young-theme-template-01/phpcs.xml.dist
wp-content/themes/nolan-young-theme-template-01/phpunit.xml.dist
wp-content/themes/nolan-young-theme-template-01/SECURITY.md
wp-content/themes/nolan-young-theme-template-01/webpack.config.js

# Plugin contributor tooling is not needed by WordPress at runtime.
wp-content/plugins/*/composer.json
wp-content/plugins/*/composer.lock
wp-content/plugins/*/phpcs.xml.dist
wp-content/plugins/*/phpunit.xml.dist
wp-content/plugins/*/tests/
wp-content/plugins/*/DEVELOPMENT.md

# Defense in depth for generated dependencies, diagnostics, and archives.
**/node_modules/
**/vendor/
**/coverage/
**/dist/
**/.env*
**/*.log
**/*.zip
**/*.tar
**/*.tar.gz
**/*.tgz
**/*.rar
**/*.7z
**/.DS_Store
**/Thumbs.db
